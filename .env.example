# ─────────────────────────────────────────────────────────────────────────────
# Golden Workflow — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Vault ─────────────────────────────────────────────────────────────────────
# Required for all tiers. Vault is the credential hub — all other secrets flow
# through it. vault.sh uses these to configure the AWS secrets engine.
export VAULT_ADDR="https://your-vault-server.example.com"
export VAULT_TOKEN="your-vault-token"

# ── AWS ───────────────────────────────────────────────────────────────────────
# These are the "master" credentials given to Vault so it can generate
# short-lived dynamic credentials for Terraform and Packer.
# Terraform/Packer never use these directly — they call vault read aws/creds/demo-role.
export AWS_REGION="us-east-2"
export AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# ── GitHub ────────────────────────────────────────────────────────────────────
# Used by vault.sh to store secret/ami-pipeline/github.
# The Harness pipeline reads this at runtime for repo clone and PR comments.
# Needs: Contents (read/write), Pull requests (read/write)
export GITHUB_TOKEN="your-github-token"

# ── S3 ────────────────────────────────────────────────────────────────────────
# Bucket name seed — Terraform creates the actual bucket.
# Must be globally unique. Suggestion: golden-workflow-demo-<your-aws-account-id>
export S3_BUCKET_NAME="your-s3-bucket-name"

# ── HCP Terraform ─────────────────────────────────────────────────────────────
# Required for Tier 2+. Used by vault.sh (stored at secret/ami-pipeline/hcp-terraform)
# and by the Harness pipeline stages that trigger HCP Terraform API runs.
export HCP_TERRAFORM_TOKEN="your-hcp-terraform-token"

# ── HCP Packer / HCP Portal ───────────────────────────────────────────────────
# Required for Tier 2+ (EC2 provisioning reads the AMI from HCP Packer Registry).
# Used by vault.sh to store secret/ami-pipeline/hcp-packer.
# Get these from: portal.cloud.hashicorp.com → Project → IAM → Service Principals
export hcp_client_id="your-hcp-service-principal-client-id"
export hcp_client_secret="your-hcp-service-principal-client-secret"
export hcp_organization_id="your-hcp-organization-id"
export hcp_project_id="your-hcp-project-id"

# ── Tier 3: Live EC2 / Drift Stages ──────────────────────────────────────────
# Add these AFTER terraform apply completes (the values come from Terraform output
# and Vault). See docs/COMPLETE-SETUP-GUIDE.md Step 10.
export EC2_IP="1.2.3.4"
export SSH_KEY_PATH="$HOME/.ssh/golden-workflow-dev.pem"

# ── Tier 4: Harness Pipeline Trigger ─────────────────────────────────────────
# These go in GitHub → Settings → Secrets and variables → Actions (NOT in this file).
# Documented here for reference only. Set them as GitHub repo secrets, not env vars.
#
#   HARNESS_API_KEY      — Harness Account Settings → API Keys → New API Key
#   HARNESS_ACCOUNT_ID   — Harness Account Settings → Overview
#   HARNESS_PROJECT_ID   — Harness Project → Settings → Project Details
#
# The pipeline also needs two Harness-native secrets (set in Harness, not here):
#   vault_addr           — same as VAULT_ADDR above
#   vault_token          — same as VAULT_TOKEN above

# ── AAP (Ansible Automation Platform) ─────────────────────────────────────────
# NOT REQUIRED. The Harness pipeline runs Ansible directly over SSH using keys
# stored in Vault. AAP is not used anywhere in harness-pipeline.yaml.
# These are stored in Vault (secret/ami-pipeline/aap) for legacy reasons only.
# Leave unset unless you are specifically integrating with AAP.
#
# export aap_url="https://your-aap-server.example.com"
# export aap_user="your-aap-username"
# export aap_pwd="your-aap-password"
