import "tfplan/v2" as tfplan

# Require all EC2 instances to have specific tags
mandatory_tags = ["Name", "Pipeline", "Environment"]

# Get all EC2 instances from the plan
ec2_instances = filter tfplan.resource_changes as _, rc {
    rc.type is "aws_instance" and
    rc.mode is "managed" and
    (rc.change.actions contains "create" or rc.change.actions contains "update")
}

# Validation function
validate_tags = func(instance) {
    tags = instance.change.after.tags

    if tags is null {
        return false
    }

    for mandatory_tags as tag {
        if tag not in keys(tags) {
            print("Instance", instance.address, "is missing required tag:", tag)
            return false
        }
    }

    return true
}

# Main rule
main = rule {
    all ec2_instances as _, instance {
        validate_tags(instance)
    }
}